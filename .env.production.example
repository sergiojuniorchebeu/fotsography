# ─── Fotsography Studio — configuration de PRODUCTION ───────────────────────
# Copier en .env sur le serveur, puis remplir les valeurs marquées « À REMPLIR ».

APP_NAME="Fotsography Studio"
APP_ENV=production
APP_KEY=                      # À REMPLIR : php artisan key:generate
APP_DEBUG=false               # Ne JAMAIS mettre true en production
APP_URL=https://studio.example.cm   # À REMPLIR : votre domaine, en https
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Code secret pour créer le premier compte admin via /register?token=…
# (ou utilisez « php artisan studio:create-admin » et laissez vide)
SETUP_TOKEN=                  # À REMPLIR : une longue chaîne aléatoire (openssl rand -hex 24)

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fotsography
DB_USERNAME=fotsography
DB_PASSWORD=                  # À REMPLIR

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# Hébergement mutualisé sans supervisor : laisser le cron traiter la file d'attente.
QUEUE_VIA_SCHEDULER=false

FILESYSTEM_DISK=local
# Où vont les sauvegardes quotidiennes. « backups » = storage/app/backups sur le serveur.
# Recommandé : un stockage externe (S3, Backblaze B2, Wasabi…) avec BACKUP_DISK=s3.
BACKUP_DISK=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Derrière Cloudflare ou un load balancer : mettre * (ou les IP du proxy)
TRUSTED_PROXIES=127.0.0.1

# Notifications sur téléphone (Web Push). Générer UNE SEULE FOIS avec
# « php artisan webpush:vapid », puis ne plus jamais les changer
# (sinon tous les téléphones abonnés cessent de recevoir les notifications).
VAPID_SUBJECT=mailto:contact@example.cm
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
